# PulseCheck service settings. Copy to .env (ignored by Git) and fill in real
# values; never commit real credentials. Limits and retention periods live in
# configs/default.yaml.

# Job database. PostgreSQL in deployment (pip install -e "backend[api,postgres]");
# leave unset for a local SQLite file under data/.
DATABASE_URL=postgresql+psycopg://pulsecheck:CHANGE_ME@localhost:5432/pulsecheck

# Queue and rate-limit store.
REDIS_URL=redis://localhost:6379/0

# Salts the client-IP hash used for rate limits; any long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PULSECHECK_SECRET_KEY=CHANGE_ME

# Comma-separated frontend origins allowed by CORS (none by default).
PULSECHECK_CORS_ORIGINS=http://localhost:5173

# "1" only behind a reverse proxy that sets X-Forwarded-For.
PULSECHECK_TRUST_PROXY=0

# Optional overrides.
# PULSECHECK_CONFIG=configs/default.yaml
# PULSECHECK_STORAGE_DIR=data/storage
# PULSECHECK_MODEL_PATH=models/<trained-model>.pkl
# PULSECHECK_FACE_MODEL=models/face_landmarker.task

# Used by docker-compose.yml for the postgres container.
POSTGRES_PASSWORD=CHANGE_ME
